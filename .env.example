# Copy this file to .env (next to costume_doorbell.py) and fill in your own values.
# Never commit your real .env: it holds your API keys.

# --- AI model that identifies costumes (Claude by default, OpenAI as the fallback) ---
ANTHROPIC_API_KEY=sk-ant-your-key-here
OPENAI_API_KEY=sk-your-key-here
# BACKEND=claude            # claude | openai | ollama (local GPU)
# MODEL=claude-opus-5-5
# EFFORT=low

# --- UniFi Protect (doorbell camera) ---
PROTECT_HOST=192.168.1.1                 # your UniFi console's LAN IP
PROTECT_API_KEY=your-protect-api-key     # an API key from your UniFi console's Integrations settings
DOORBELL_CAMERA_ID=                      # blank = auto-find; or run: python costume_doorbell.py --list-cameras

# --- Voices (ElevenLabs), played on Sonos speakers straight from this PC ---
ELEVENLABS_API_KEY=your-elevenlabs-key
SONOS_IPS=192.168.1.60                   # one or several speakers: 192.168.1.60,192.168.1.61
# VOICES=ilinca,malyx                    # they take turns, one announcement each
# SPEAK_VOLUME=60                        # blank = the speaker's current volume
# AUDIO_PORT=8089                        # the Sonos fetch the clip from this PC on this TCP port

# --- Fallback voice through Hubitat's Maker API (used only if ElevenLabs fails) ---
HUBITAT_HOST=192.168.1.50
MAKER_APP_ID=123
MAKER_TOKEN=your-maker-api-token
SONOS_DEVICE_ID=456                      # Hubitat device ID(s) of the Sonos: 456 or 456,457
# SPEAK_VOICE=Ruth

# --- Doorbell button press: a laugh on the Sonos (the doorbell plays its own recording) ---
# RING_SOUND=voice-samples/laugh-malyx-b.mp3   # blank = off
# RING_DELAY_SEC=4

# --- Porch timing ---
# RECHECK_SEC=10           # while anyone is on the porch, look again this often
# REPEAT_WINDOW_SEC=120    # don't re-announce a costume seen this recently
# LCD_SECONDS=15           # how long the doorbell screen shows "I SEE ...!"; 0 = off

# --- Visit log (off by default: the photos show visitors) ---
# LOG_VISITS=text          # text | images | audio | a mix like text,audio | all
